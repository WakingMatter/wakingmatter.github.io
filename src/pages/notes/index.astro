---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Notes — Waking Matter"
  description="Notes from Waking Matter on cumulative intelligence, written without claims of novelty or unpublished results."
  canonical="https://wakingmatter.com/notes/"
  current="notes"
>
  <main id="content" class="wrap">
    <header class="page-hero">
      <p class="label">Notes</p>
      <h1>Written when we have something careful to say.</h1>
      <p class="lede">
        These are essays, not papers. They do not stand in for experiments we
        have not run, and the index will stay short until there is another
        careful thing to say. A feed is available as <a href="/rss.xml">RSS</a>.
      </p>
    </header>

    <div class="prose-page">
      <div class="note-index">
        {notes.map((note) => (
          <a href={`/notes/${note.id}/`}>
            <span class="meta">{note.data.pubDate.toISOString().slice(0, 10)}</span>
            <span>
              <h2>{note.data.title}</h2>
              <p>{note.data.description}</p>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
