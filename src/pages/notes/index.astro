---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Notes | Waking Matter"
  description="Notes on how useful experience should change an agent’s next decision."
  canonical="https://wakingmatter.com/notes/"
  current="notes"
>
  <main id="content" class="wrap">
    <header class="page-hero">
      <p class="label">Notes</p>
      <h1>Arguments for the thesis behind the work.</h1>
      <p class="lede">
        Essays on why intelligence should accumulate and what it will take.
        We publish when there is something worth arguing. A feed is available
        as <a href="/rss.xml">RSS</a>.
      </p>
    </header>

    <div class="prose-page">
      <div class="note-index">
        {notes.map((note) => (
          <a href={`/notes/${note.slug}/`}>
            <span class="meta">{note.data.pubDate.toISOString().slice(0, 10)}</span>
            <span>
              <h2>{note.data.title}</h2>
              <p>{note.data.description}</p>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
