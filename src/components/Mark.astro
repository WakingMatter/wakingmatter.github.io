  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 120"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="32" y="16" width="16" height="88" rx="8"></rect>
  <rect x="72" y="16" width="16" height="88" rx="8"></rect>
  <circle cx="60" cy="60" r="11"></circle>
</svg>
