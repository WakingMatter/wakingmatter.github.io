---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 120"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="aperturePillar" x1="40" y1="16" x2="40" y2="104" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3A3E3D"></stop>
      <stop offset="0.42" stop-color="#D6D9D7"></stop>
      <stop offset="1" stop-color="#1C1F1E"></stop>
    </linearGradient>
    <radialGradient id="apertureSphere" cx="40%" cy="32%" r="68%">
      <stop offset="0" stop-color="#F7F6F3"></stop>
      <stop offset="0.38" stop-color="#A7B0AD"></stop>
      <stop offset="0.72" stop-color="#5C8F8A"></stop>
      <stop offset="1" stop-color="#2A2A2A"></stop>
    </radialGradient>
  </defs>
  <rect x="32" y="16" width="16" height="88" rx="8" fill="url(#aperturePillar)"></rect>
  <rect x="72" y="16" width="16" height="88" rx="8" fill="url(#aperturePillar)"></rect>
  <circle cx="60" cy="60" r="11" fill="url(#apertureSphere)"></circle>
</svg>
